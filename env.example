# ==============================================================================
# Variables de Entorno de Referencia - Servicio test-fastapi
# ==============================================================================
# Copia este archivo como '.env' en la raíz del servicio para configurar
# las variables locales o pasárselas a Docker Compose.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Servicio
# ------------------------------------------------------------------------------
SERVICE_NAME=test-fastapi-service
SERVICE_PORT=8083
DEPLOYMENT_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Conexiones a Persistencia, Caché y Broker de Mensajería
# ------------------------------------------------------------------------------
# Si ejecutas localmente sin Docker, usa 'localhost'. Si usas Docker Compose,
# las URLs por defecto resuelven a los nombres de servicio de la red interna.
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://app:app@localhost:5672/
RABBITMQ_QUEUE=test.events

# Variables auxiliares de credenciales utilizadas por Docker Compose
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# ------------------------------------------------------------------------------
# 3. Google Gemini LLM y RAG (Retrieval-Augmented Generation)
# ------------------------------------------------------------------------------
# Obtén tu clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini a invocar (ej. gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Directorio que contiene los archivos Markdown/texto del corpus de protocolos
PROTOCOLS_DIR=data/protocols

# ------------------------------------------------------------------------------
# 4. Observabilidad y Telemetría (OpenTelemetry)
# ------------------------------------------------------------------------------
# Endpoint OTLP HTTP para trazas y logs (usar http://otel-collector:4318 en Docker)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

