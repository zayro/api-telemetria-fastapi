# ==============================================================================
# Variables de Entorno de Referencia - Servicio test-fastapi
# ==============================================================================
# Copia este archivo como '.env' en la raÃ­z del servicio para configurar
# las variables locales o pasÃ¡rselas a Docker Compose.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ConfiguraciÃ³n del Servicio
# ------------------------------------------------------------------------------
SERVICE_NAME=test-fastapi-service
SERVICE_PORT=8083
DEPLOYMENT_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Conexiones a Persistencia, CachÃ© y Broker de MensajerÃ­a
# ------------------------------------------------------------------------------
# Si ejecutas localmente sin Docker, usa 'localhost'. Si usas Docker Compose,
# las URLs por defecto resuelven a los nombres de servicio de la red interna.
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=test.events
# Kafka consumer (apagado por defecto).
# Si se habilita, el servicio ejecuta un loop de consumo en background durante el lifespan.
KAFKA_CONSUMER_ENABLED=false
# Grupo del consumer (por defecto: {SERVICE_NAME}-consumer).
KAFKA_CONSUMER_GROUP_ID=test-fastapi-service-consumer
# Tópicos a consumir (CSV). Por defecto usa KAFKA_TOPIC.
KAFKA_CONSUMER_TOPICS=test.events

# Variables auxiliares de credenciales utilizadas por Docker Compose
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ------------------------------------------------------------------------------
# 3. Google Gemini LLM y RAG (Retrieval-Augmented Generation)
# ------------------------------------------------------------------------------
# ObtÃ©n tu clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini a invocar (ej. gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Modelo y dimension de embeddings para el indice vectorial del RAG
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# Tamano maximo de archivo permitido en /api/test/protocols/upload (bytes)
MAX_UPLOAD_BYTES=20971520

# Directorio que contiene los archivos Markdown/texto del corpus de protocolos
PROTOCOLS_DIR=data/protocols

# ------------------------------------------------------------------------------
# 4. Observabilidad y TelemetrÃ­a (OpenTelemetry)
# ------------------------------------------------------------------------------
# Endpoint OTLP HTTP para trazas y logs (usar http://otel-collector:4318 en Docker)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

